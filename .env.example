# pantry — configuration.
#
# Two variables and nothing else. There is no database URL because there is no
# database (Phase 1: the registry is repository data read from disk), and no
# service URLs because pantry describes how to reach a service and never calls
# one.

# Where the registry lives: index.yml plus services/*.cafaye.yml. The image
# ships it at /etc/pantry/registry; a checkout runs from ./registry.
PANTRY_REGISTRY_DIR=registry

# The listen address. kit's Rust template exposes 8080.
PANTRY_BIND=0.0.0.0:8080

# Log filter. The default keeps startup and refusals and drops per-request
# chatter; the service logs one line per failed request, not per request.
# RUST_LOG=info,axum=warn,tower_http=warn
