#!/usr/bin/env bash
# bin/prime-go — the Go tier of pantry's gate.
#
#   ./bin/prime-go   build, vet, test              (no network, no database)
#
# WHY A SECOND SCRIPT rather than six more steps in bin/prime. bin/prime is the
# declared gate (gate.yml: `command: [bin/prime]`) and the Rust tier; this is
# the Go tier, run by bin/prime's last step and runnable on its own for a narrow
# verification. A developer working on the Go service should not have to compile
# 110 crates to find out whether `go vet` is happy, and the two gates having one
# file each is what makes "which tier is red" a question with an answer.
#
# Green on a bare machine with a Go toolchain on PATH. The two data-path packages
# (`internal/pantrydb`, `internal/httpapi`) need a PostgreSQL, and they do not
# bring one: they run `tests/rls.sh --serve`, which starts a scratch cluster,
# applies `migrations/` and seeds `tests/seed.sql`, then removes it on exit. A
# machine with no PostgreSQL gets a COUNTED SKIP from that harness naming the
# reason — printed as a `skip:` row by both — rather than a suite that reports
# `ok` without having checked anything.
set -euo pipefail
set -o pipefail

cd "$(dirname "$0")/.."

step() { printf '\n\033[1m==> %s\033[0m\n' "$1"; }

# THE TOOLCHAIN ASSERTION, and it is here for the reason bin/prime asserts
# rustc against mise.toml: this repository now pins a Go version in TWO files
# (mise.toml's `go` and Dockerfile's ARG GO_VERSION), and nothing makes
# the go command enforce either. Without the check a developer on a newer Go
# silently produces a binary CI never built, and reads the difference as a
# defect in the code under test — the cafaye-rb lesson, in a second language.
if ! command -v go >/dev/null 2>&1; then
  echo "bin/prime-go: go is not on PATH — run 'mise install' in this worktree" >&2
  exit 127
fi

pinned_go="$(sed -n 's/^go *= *"\(.*\)"/\1/p' mise.toml)"
if [ -z "$pinned_go" ]; then
  echo "bin/prime-go: mise.toml pins no go toolchain, so this gate cannot check the" >&2
  echo "  toolchain it is about to run. Either restore the pin or stop claiming one." >&2
  exit 127
fi

# go.mod's own `go` directive is the third copy of the number, and it is the one
# the compiler enforces. A go.mod newer than the pin means somebody raised the
# language version without raising the pin, and the error that produces is a
# wall of text about language features.
mod_go="$(sed -n 's/^go *\([0-9][0-9.]*\).*/\1/p' go.mod)"
if [ -n "$mod_go" ] && [ "$mod_go" != "$pinned_go" ]; then
  echo "bin/prime-go: go.mod declares go $mod_go and mise.toml pins $pinned_go." >&2
  echo "  One language version, two files (go.mod, mise.toml) plus the ARG" >&2
  echo "  GO_VERSION in Dockerfile that names the image tag. Fix whichever is" >&2
  echo "  wrong rather than the one you read first." >&2
  exit 127
fi

actual_go="$(go version | awk '{print $3}' | sed 's/^go//')"
if [ "$actual_go" != "$pinned_go" ] && [ "${actual_go#"$pinned_go."}" = "$actual_go" ]; then
  echo "bin/prime-go: go is $actual_go, and mise.toml pins $pinned_go." >&2
  echo "  Run 'mise install' in this worktree. Continuing would report compiler" >&2
  echo "  errors about language features as if they were defects in the code." >&2
  exit 127
fi

step "toolchain: go $actual_go (mise.toml pins $pinned_go)"
go version

step "gofmt -l"
# `-l` prints the files that NEED formatting and exits 0 either way, so the count
# is the assertion. An empty list is the pass and a non-empty one is a red that
# names the file.
unformatted="$(gofmt -l ./cmd ./internal)"
if [ -n "$unformatted" ]; then
  echo "bin/prime-go: these files are not gofmt-clean:" >&2
  echo "$unformatted" | sed 's/^/  /' >&2
  exit 1
fi
echo "every file under ./cmd and ./internal is gofmt-clean"

step "go build ./..."
go build ./...

step "go vet ./..."
go vet ./...

step "go test ./..."
# `-v`, AND THE OUTPUT IS FILTERED, and both halves are load-bearing.
#
# -count=1 defeats the test cache: a gate that can report a stale green is a gate
# that reports what it ran last, not what it would report now.
#
# `go test` DISCARDS a passing package's output entirely. A package that prints its
# own `skip: <reason>` row therefore prints it into a void on every green run,
# which is precisely the silent pass this repository has been bitten by before: a
# suite that reports `ok` without having checked anything, and nobody can tell it
# apart from one that checked everything. It was measured here rather than assumed
# — `internal/pantrydb` printed a correct counted-skip row and it appeared nowhere.
#
# So the suite runs verbosely and the rows are echoed, and the filtering keeps the
# gate readable: every package result, every failure in full (the `||` branch), and
# the data path's own `pantrydb:` summary lines.
#
# No -race here deliberately. The catalog introduces no shared mutable state of its
# own — the pool hands out already-role-checked connections — so a race detector
# that finds nothing is cost without signal.
out="$(go test -count=1 -v ./... 2>&1)" || {
  echo "$out"
  echo "bin/prime-go: go test failed; the full -v output is above." >&2
  exit 1
}
echo "$out" | grep -E '^(ok|FAIL|---|\?|pantrydb:)' || true

# THE COUNTED SKIP, made countable AT THE GATE rather than inside `go test`.
#
# `internal/pantrydb` prints how many of its gates did not run and why. A machine
# with no PostgreSQL is a legitimate green — `tests/rls.sh` skips on one too, and
# for the same reason — but it must never be an invisible green, so the count is
# surfaced here and `PANTRY_DB_REQUIRED=1` is what turns it into a red. That is the
# same pair of contracts `tests/rls.sh` keeps (`PANTRY_RLS_REQUIRED`), and a gate
# with two ways of being skipped and one way of insisting is a gate whose silence
# can be read.
did_not_run="$(printf '%s\n' "$out" |
  sed -n 's/^pantrydb: gates: [0-9]* entered, \([0-9]*\) did not run.*/\1/p' | head -1)"
if [ -z "$did_not_run" ]; then
  echo "bin/prime-go: internal/pantrydb printed no 'gates:' summary, so its skip count is" >&2
  echo "  unknown, and a gate that cannot count its own skips is a gate that cannot" >&2
  echo "  be trusted to have run them." >&2
  exit 1
fi
if [ "$did_not_run" != "0" ]; then
  echo "data path: $did_not_run check(s) DID NOT RUN against a database (counted, and named above)"
  if [ "${PANTRY_DB_REQUIRED:-0}" = "1" ]; then
    echo "bin/prime-go: PANTRY_DB_REQUIRED=1 and there is no PostgreSQL to check against." >&2
    exit 3
  fi
else
  echo "data path: every check ran against a real PostgreSQL (0 skipped)"
fi

step "the generated server matches the OpenAPI document"
# Not `go generate` — regeneration needs the generator, which is fetched on
# purpose and needs the network on a cold machine. This asserts the property that
# matters without moving go.sum: the generated file is in the tree, it names the
# generator version it came from, and every operationId in the document has an
# implementation (the compile above is what holds the last one).
gen="internal/api/api.gen.go"
if [ ! -f "$gen" ]; then
  echo "bin/prime-go: $gen is missing. Run 'go generate ./internal/api/'." >&2
  exit 1
fi
grep -q '^// Code generated by github.com/oapi-codegen/oapi-codegen/v2 version v2\.8\.0 DO NOT EDIT\.$' "$gen" || {
  echo "bin/prime-go: $gen does not carry the oapi-codegen v2.8.0 header. The" >&2
  echo "  generator is pinned on internal/api/generate.go's //go:generate line; if" >&2
  echo "  that pin moved, say so in the same commit as the regenerated file." >&2
  exit 1
}
echo "$gen is oapi-codegen v2.8.0 output, committed"

step "ok"