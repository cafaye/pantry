#!/usr/bin/env bash
# bin/prime — the gate. Everything that must pass before a commit lands.
#
#   ./bin/prime   the Go tier, the RLS suite, then the manifest lint
#
# THREE TIERS, and they are three subjects rather than three languages. The Go
# tier builds and tests the service; the RLS tier is about the migrations and is
# the only one that starts a database; the manifest lint is about this
# repository's own `cafaye.yml` and every registry entry in it.
#
# ONE LANGUAGE NOW. This script used to assert a Rust toolchain against
# `mise.toml`, exit 127 on a mismatch, and then run `cargo fmt`, `cargo build`,
# `cargo clippy` and `cargo test` across ~110 crates for the `src/` service that
# stood beside the Go one. `src/` is gone. The toolchain assertion moved to
# `bin/prime-go`, which already had the same check for Go against the same two
# files, so nothing was lost by not repeating it here — a second assertion of the
# same pin in a second script is a second thing to forget.
#
# THE RUST TIER WAS NOT DELETED, IT WAS REPLACED, and the difference is worth
# being exact about. `tests/rls.sh` and `tests/rls_checks.sh` (99 checks) and
# `tests/seed.sql` already existed in shell and Go, and they are what the
# migrations are actually verified by. The Rust suite that went with `src/` was
# 146 tests over the registry manifest format, the vendored core schema pin and
# workspace drift. Some of that is genuinely gone and is named in
# REPORT-registry-norust-03.md rather than rounded away.
#
# Green on a bare machine, with no cafaye sibling checkouts and no PostgreSQL:
# the tiers that need either report themselves as COUNTED SKIPS naming the
# reason. That is deliberate — a gate that needs a whole workspace to produce a
# red is a gate nobody runs, and a gate whose silence reads as a pass is the
# failure this repository has been bitten by more than once.
#
# In the moon/cafaye workspace, the manifest lint runs for real:
#
#   PANTRY_CAFAYE_ROOT=/Users/kaka/Code/any/moon/cafaye ./bin/prime
set -euo pipefail

# The gate discipline from PLAN.md §1: a pipeline's exit code is the LAST
# command's, so a failing suite read through a pipe looks like a pass. That is
# exactly how a broken packet reached master once. Every command here runs
# unpiped, and `set -e` is the whole reason this is a script and not a Makefile
# target someone ran with `make -k`.
set -o pipefail

cd "$(dirname "$0")/.."

step() { printf '\n\033[1m==> %s\033[0m\n' "$1"; }

# ---------------------------------------------------------------------------
# THE GO TIER
# ---------------------------------------------------------------------------
# gofmt, build, vet, test, the generated-server check, and the two counted skip
# reports (the data path's own gates, and the suite's pass count). It is a script
# rather than five more steps here so that a developer working on one thing does
# not have to run all three tiers to learn whether it is happy, and so that
# "which tier is red" is a question with an answer. See bin/prime-go, which also
# owns the toolchain assertion.
step "the Go tier: gofmt, build, vet, test"
./bin/prime-go

step "the RLS suite, against a real postgres"
# THIS TIER IS ABOUT THE MIGRATIONS, and it is the only tier in this gate that
# starts a database. It is here and not in `bin/prime-go` because the Go tier's
# stated subject is "no network, no database" (its own header), and quietly
# changing that would be a worse surprise than one more step in the gate.
#
# THE SKIP IS COUNTED, not absent. `tests/rls.sh` prints one `skip:` line naming
# the reason when it cannot find `pg_ctl`, and the count is printed below and
# asserted on, for the reason this script counts everything: a tier that quietly
# did not run is indistinguishable from a tier that passed. `PANTRY_RLS_REQUIRED=1`
# turns the skip into an exit 3, and that is how CI should run it — a CI job that
# has a postgres service should be red when it does not, and a developer with no
# postgres should still be able to run the gate.
rls_log="$(mktemp "${TMPDIR:-/tmp}/pantry-prime-rls.XXXXXX")"
trap 'rm -f "$rls_log"' EXIT
set +e
./tests/rls.sh 2>&1 | tee "$rls_log"
rls_status="${PIPESTATUS[0]}"
set -e
rls_line="$(grep -m1 '^checks: ' "$rls_log" || true)"
rls_checks="$(printf '%s' "$rls_line" | awk '{print $2}')"
rls_passed="$(printf '%s' "$rls_line" | awk '{print $4}')"
rls_skipped="$(grep -c '^skip: ' "$rls_log" || true)"
echo "rls: ${rls_passed:-0} of ${rls_checks:-0} checks passed, ${rls_skipped} tier skipped"
if [[ "$rls_skipped" -ne 0 ]]; then
  # Named, for the same reason every other count here is named: a count with no
  # variable is a number nobody can act on.
  echo "  the RLS tier did not run, and those counted as nothing. Install a"
  echo "  PostgreSQL server or set PANTRY_PG_BIN to its bin directory."
  grep '^skip: ' "$rls_log" | sort -u | sed 's/^/  /'
fi
if [[ "$rls_status" -ne 0 ]]; then
  echo "bin/prime: tests/rls.sh exited ${rls_status}" >&2
  exit "$rls_status"
fi

step "the manifest validates against core's schema"
if [[ -f ../caf/go.mod ]]; then
  # This repository's own manifest, and every registry entry. `contract lint`
  # takes one path, so the two are two commands — and the paths are absolute
  # because a worktree is not named `pantry`.
  here="$PWD"
  (cd ../caf && go run ./cmd/caf contract lint "$here/cafaye.yml")
  (cd ../caf && go run ./cmd/caf contract lint "$here/registry/services")
else
  echo "skipped: ../caf is not a checkout here. Validate with:"
  echo "  cd ../caf && go run ./cmd/caf contract lint $PWD/cafaye.yml"
  echo "and every registry entry with:"
  echo "  cd ../caf && go run ./cmd/caf contract lint $PWD/registry/services"
fi

step "ok"